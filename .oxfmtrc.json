{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/build",
    "**/coverage",
    "**/dist",
    "pnpm-lock.yaml",
    "**/snapshots",
    "**/node_modules",
    "node_modules",
    ".changeset"
  ]
}
