{
  "name": "parcel-react-static-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "source": "routes.ts",
  "@renr/parcel-plugin-rsc-router": {
    "source": "src/pages/**/*.{tsx,mdx}"
  },
  "targets": {
    "default": {
      "context": "react-server",
      "distDir": "dist",
      "includeNodeModules": {
        "shiki": false
      }
    }
  },
  "@renr/parcel-reporter-docgen": {
    "source": "./src/components/Counter.tsx",
    "output": "docs/components"
  },
  "scripts": {
    "start": "npx http-server ./dist",
    "dev": "parcel serve",
    "build": "parcel build"
  },
  "dependencies": {
    "@cumulo/core": "^0.2.0-alpha.2",
    "@cumulo/css": "^0.2.0-alpha.2",
    "@parcel/rsc": "^3.0.0-alpha.3",
    "@renr/parcel-rsc-router": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-parcel": "^19.3.0"
  },
  "devDependencies": {
    "@renr/parcel-config-rsc-router": "workspace:*",
    "@renr/parcel-reporter-docgen": "workspace:*",
    "@cumulo/parcel-plugin": "^0.2.0-alpha.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "parcel": "^3.0.0-alpha.3",
    "shiki": "^4.5.0"
  }
}
