{
  "name": "@renr/parcel-rsc-router",
  "version": "1.0.0-beta.11",
  "author": "Ren Rizzolo",
  "license": "MIT",
  "description": "Parcel rsc router",
  "keywords": [
    "parcel",
    "rsc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renrizzolo/parcel-rsc-react.git"
  },
  "type": "module",
  "main": "./dist/esm/index.mjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsdown"
  },
  "peerDependencies": {
    "react": "^19",
    "@parcel/rsc": "^2",
    "react-server-dom-parcel": "^19"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "@types/react": "^19.3.0",
    "@parcel/rsc": "^2.16.4"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
